  "components": {
    "schemas": {
      "ApprovalRequest": {
        "properties": {
          "hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Hash"
          },
          "confirmed": {
            "type": "boolean",
            "const": true,
            "title": "Confirmed"
          }
        },
        "type": "object",
        "required": [
          "hash",
          "confirmed"
        ],
        "title": "ApprovalRequest"
      },
      "AssistantRequest": {
        "properties": {
          "workshop_id": {
            "type": "string",
            "maxLength": 30,
            "title": "Workshop Id",
            "default": "ATELIER-1"
          },
          "mode": {
            "type": "string",
            "enum": [
              "question",
              "plan"
            ],
            "title": "Mode",
            "default": "question"
          },
          "question": {
            "type": "string",
            "maxLength": 4000,
            "title": "Question",
            "default": ""
          },
          "instance_id": {
            "type": "string",
            "maxLength": 40,
            "title": "Instance Id",
            "default": "demo"
          },
          "import_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Import Id"
          },
          "baseline_draft_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline Draft Id"
          },
          "event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Event"
              },
              {
                "type": "null"
              }
            ]
          },
          "prepare": {
            "type": "boolean",
            "title": "Prepare",
            "default": true
          }
        },
        "type": "object",
        "title": "AssistantRequest"
      },
      "Body_analyze_analyze_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_analyze_post"
      },
      "Body_import_erp_imports_erp_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_import_erp_imports_erp_post"
      },
      "Body_import_pdf_imports_pdf_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_import_pdf_imports_pdf_post"
      },
      "Event": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "breakdown",
              "urgent",
              "material_delay"
            ],
            "title": "Kind"
          },
          "start": {
            "type": "integer",
            "maximum": 1440.0,
            "minimum": 0.0,
            "title": "Start"
          },
          "duration": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1440.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration"
          },
          "machine_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Machine Id"
          },
          "order_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 20
              },
              {
                "type": "null"
              }
            ],
            "title": "Order Id"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "start"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LinkRequest": {
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64,
            "minLength": 8,
            "title": "Code"
          },
          "telegram_id": {
            "type": "string",
            "pattern": "^\\d{1,20}$",
            "title": "Telegram Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "telegram_id"
        ],
        "title": "LinkRequest"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "PublicationRequest": {
        "properties": {
          "approval_token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Approval Token"
          }
        },
        "type": "object",
        "required": [
          "approval_token"
        ],
        "title": "PublicationRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}